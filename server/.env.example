# Express API port
PORT=4000

# PostgreSQL connection string (required)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/expensemate

# Long random string used to sign session cookies (required, min 16 chars)
# Generate one with: openssl rand -hex 32
SESSION_SECRET=change-this-to-a-long-random-string

# Frontend origin allowed by CORS
CLIENT_ORIGIN=http://localhost:5173

# development | test | production
NODE_ENV=development

# Integration tests read server/.env.test instead and require a separate
# database whose name ends in "_test", e.g.:
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/expensemate_test
