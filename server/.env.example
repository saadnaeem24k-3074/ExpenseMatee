# Express API port
PORT=4001

# PostgreSQL connection string (required)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/expensemate

# Long random string used to sign session cookies (required, min 16 chars)
# Generate one with: openssl rand -hex 32
SESSION_SECRET=change-this-to-a-long-random-string

# Frontend origin(s) allowed by CORS. Comma/space separated list.
# In development and test the API also accepts any loop-back origin
# (http://localhost:<port>, http://127.0.0.1:<port>) so the Vite preview
# build (port 4173) works without extra configuration. In production only
# the entries below are allowed.
# Examples:
#   CLIENT_ORIGIN=http://localhost:5173,http://localhost:4173
#   CLIENT_ORIGIN=https://yourapp.com
CLIENT_ORIGIN=http://localhost:5173

# development | test | production
NODE_ENV=development

# Integration tests read server/.env.test instead and require a separate
# database whose name ends in "_test", e.g.:
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/expensemate_test
